# --- App ---
APP_NAME="VastriqCloset"
APP_ENV="local"
APP_PORT=5000
APP_HOST="http://localhost:5000"

# --- Database (MongoDB) ---
# Local dev via `pnpm --filter @mejjos/api dev:mongo` (in-memory 2-node replica set)
DATABASE_URL="mongodb://127.0.0.1:27017,127.0.0.1:27018/vastriq?replicaSet=testset"

# --- Redis (Bull queues + cache + socket.io adapter) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=""
# Set to true for managed Redis that requires TLS (e.g. Upstash). Keep false for local dev.
REDIS_TLS=false

# --- JWT ---
AT_SECRET="change-me-access-secret"
RT_SECRET="change-me-refresh-secret"

# --- SMTP (email notifications) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="********"
SMTP_PASSWORD="********"
SMTP_FROM="VASTRIQ CLOSET"

# --- Uploads / Media (LOCAL for dev, IMAGEKIT for prod) ---
FILE_UPLOAD_DRIVER="LOCAL"
# Required when FILE_UPLOAD_DRIVER=IMAGEKIT (private key stays server-side only)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# --- Throttling / OTP (minutes) ---
DEFAULT_THROTTLE_TIME=1
DEFAULT_THROTTLE_LIMIT=60
IP_THROTTLE_TIME=5
IP_THROTTLE_LIMIT=5
OTP_EXPIRY_TIME=5

# --- CORS (web + admin origins) ---
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8002"

# --- Cache ---
APP_CACHE_DRIVER="REDIS"
APP_CACHE_DEFAULT_TTL=6000
APP_CACHE_REDIS_STORE_HOST="localhost"
APP_CACHE_REDIS_STORE_PORT=6379
APP_CACHE_REDIS_STORE_USERNAME=default
APP_CACHE_REDIS_STORE_PASSWORD=

# --- Dev OTP bypass (NEVER enable in production) ---
AUTH_DEV_BYPASS_ENABLED=true
AUTH_DEV_MASTER_OTP=000000
AUTH_DEV_PHONE_ALLOWLIST=+919999900001,+919999900002,+919999900003

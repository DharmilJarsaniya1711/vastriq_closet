# API + realtime
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# next/image allowed hosts (include the ImageKit host)
NEXT_PUBLIC_DOMAINS="http://localhost:3000,https://ik.imagekit.io"

# ImageKit client-side direct upload + rendering (no private key here)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""

# Use MSW mocks instead of the real API (false for real dev)
NEXT_PUBLIC_ENABLE_API_MOCKING=false
